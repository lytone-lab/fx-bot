#!/usr/bin/env python3
"""
backtest2.py - trade-by-trade backtester with stop loss, take profit, shorts,
futures costs, a trade log and an interactive chart you open in the browser.

Needs: pip install pandas numpy plotly
Data : the CSV files already made by backtest.py fetch (data/BTC_USDT_4h.csv ...)

Examples
  python backtest2.py run data/BTC_USDT_4h.csv --tf 4h --strategy trend_atr --chart
  python backtest2.py run data/ETH_USDT_4h.csv --tf 4h --strategy trend_atr --market futures --start 2024-10-09 --chart
  python backtest2.py run data/BTC_USDT_4h.csv --tf 4h --strategy trend_atr --params "fast=5,slow=200,atr_mult=2.5,rr=3"
  python backtest2.py run --synthetic --tf 4h --strategy trend_atr --chart      (engine self-check, fake prices)
"""
import argparse
import math
import os
import webbrowser

import numpy as np
import pandas as pd

TF_MS = {"1m": 60_000, "5m": 300_000, "15m": 900_000, "30m": 1_800_000,
         "1h": 3_600_000, "4h": 14_400_000, "1d": 86_400_000}


def periods_per_year(tf):
    return 365 * 24 * 3600 * 1000 / TF_MS[tf]


# ------------------------------------------------------------------ data
def load(path):
    return pd.read_csv(path, parse_dates=["dt"]).set_index("dt").sort_index()


def synthetic(n=6000, seed=1):
    rng = np.random.default_rng(seed)
    close = 20000 * np.exp(np.cumsum(rng.normal(0.00003, 0.012, n)))
    open_ = np.r_[close[0], close[:-1]]
    hi = np.maximum(open_, close) * (1 + np.abs(rng.normal(0, 0.004, n)))
    lo = np.minimum(open_, close) * (1 - np.abs(rng.normal(0, 0.004, n)))
    idx = pd.date_range("2023-01-01", periods=n, freq="4h", tz="UTC")
    return pd.DataFrame({"open": open_, "high": hi, "low": lo, "close": close,
                         "volume": rng.uniform(100, 1000, n)}, index=idx)


def atr(df, n=14):
    pc = df["close"].shift(1)
    tr = pd.concat([df["high"] - df["low"], (df["high"] - pc).abs(), (df["low"] - pc).abs()], axis=1).max(axis=1)
    return tr.ewm(alpha=1 / n, adjust=False).mean()


# ------------------------------------------------------------ strategies
# A strategy gets the candles and returns a table with, for every candle:
#   side        1 = go long, -1 = go short, 0 = nothing   (decided at that candle's CLOSE)
#   sl, tp      absolute stop-loss and take-profit prices for that setup
#   close_long  True = exit any long at the next open
#   close_short True = exit any short at the next open
# The engine enters at the NEXT candle's open, so nothing here can see the future.
def strat_trend_atr(df, fast=10, slow=200, atr_n=14, atr_mult=2.0, rr=2.0, allow_short=True):
    """Moving-average cross with an ATR stop and a fixed reward:risk target."""
    f = df["close"].rolling(fast).mean()
    s = df["close"].rolling(slow).mean()
    up = (f > s) & (f.shift(1) <= s.shift(1))
    dn = (f < s) & (f.shift(1) >= s.shift(1))
    risk = atr(df, atr_n) * atr_mult
    side = pd.Series(0, index=df.index)
    side[up] = 1
    if allow_short:
        side[dn] = -1
    sl = np.where(side == 1, df["close"] - risk, np.where(side == -1, df["close"] + risk, np.nan))
    tp = np.where(side == 1, df["close"] + risk * rr, np.where(side == -1, df["close"] - risk * rr, np.nan))
    return pd.DataFrame({"side": side, "sl": sl, "tp": tp, "close_long": dn, "close_short": up}, index=df.index)


def strat_mine(df, **kw):
    """
    YOUR strategy goes here (JeaFX price action, Fabio order-flow model, ...).
    Build the same five columns as strat_trend_atr, using ONLY information up to each candle's close.
    """
    raise NotImplementedError("Write the exact entry / stop / target rules first, then they go here.")


STRATEGIES = {"trend_atr": strat_trend_atr, "mine": strat_mine}


# ---------------------------------------------------------------- engine
def run_engine(df, sig, fee, slip, risk_pct, leverage, capital, allow_short, funding, tf):
    o, h, l, c = (df[k].values for k in ("open", "high", "low", "close"))
    idx = df.index
    n = len(df)
    side = sig["side"].values.astype(int)
    if not allow_short:
        side = np.where(side < 0, 0, side)
    sl_s, tp_s = sig["sl"].values, sig["tp"].values
    cl_long, cl_short = sig["close_long"].values.astype(bool), sig["close_short"].values.astype(bool)
    hours_per_bar = TF_MS[tf] / 3_600_000

    equity = capital
    curve = np.full(n, np.nan)
    trades = []
    pos = 0
    entry = sl = tp = qty = risk_amt = entry_fee = 0.0
    entry_i = 0

    def close_trade(t, px, reason, equity):
        notional_exit = qty * px
        exit_fee = notional_exit * fee
        bars = t - entry_i + 1
        fund = pos * qty * entry * funding * (bars * hours_per_bar / 8.0)  # longs pay when funding > 0
        gross = (px - entry) * pos * qty
        pnl = gross - entry_fee - exit_fee - fund
        trades.append({
            "id": len(trades) + 1, "side": "LONG" if pos > 0 else "SHORT",
            "entry_time": idx[entry_i], "entry": entry, "sl": sl, "tp": tp,
            "exit_time": idx[t], "exit": px, "reason": reason, "qty": qty,
            "pnl": pnl, "r": pnl / risk_amt if risk_amt else np.nan,
            "fees": entry_fee + exit_fee, "funding": fund, "bars": bars,
            "equity_after": equity + pnl})
        return equity + pnl

    for t in range(n):
        # 1) enter at this candle's open, from the signal of the previous candle
        if pos == 0 and t > 0 and side[t - 1] != 0 and not np.isnan(sl_s[t - 1]) and equity > 0:
            s = int(side[t - 1])
            px = o[t] * (1 + slip * s)  # slippage always works against you
            dist = (px - sl_s[t - 1]) * s
            ok = dist > 0 and (tp_s[t - 1] - px) * s > 0
            if ok and leverage > 1 and dist / px > 0.9 / leverage:
                ok = False  # stop is further than the liquidation price: skip the trade
            if ok:
                q = equity * risk_pct / dist
                if q * px > equity * leverage:
                    q = equity * leverage / px
                pos, entry, sl, tp, qty = s, px, float(sl_s[t - 1]), float(tp_s[t - 1]), q
                risk_amt = q * dist
                entry_fee = q * px * fee
                entry_i = t

        # 2) manage the open trade inside this candle (stop is checked first = pessimistic)
        if pos != 0:
            px = reason = None
            if pos == 1:
                if o[t] <= sl:
                    px, reason = o[t] * (1 - slip), "SL"
                elif l[t] <= sl:
                    px, reason = sl * (1 - slip), "SL"
                elif o[t] >= tp:
                    px, reason = o[t], "TP"
                elif h[t] >= tp:
                    px, reason = tp, "TP"
            else:
                if o[t] >= sl:
                    px, reason = o[t] * (1 + slip), "SL"
                elif h[t] >= sl:
                    px, reason = sl * (1 + slip), "SL"
                elif o[t] <= tp:
                    px, reason = o[t], "TP"
                elif l[t] <= tp:
                    px, reason = tp, "TP"
            if px is None and t > entry_i and t > 0:
                if (pos == 1 and cl_long[t - 1]) or (pos == -1 and cl_short[t - 1]):
                    px, reason = o[t] * (1 - slip * pos), "SIGNAL"
            if px is not None:
                equity = close_trade(t, px, reason, equity)
                pos = 0

        if pos != 0:
            curve[t] = equity + (c[t] - entry) * pos * qty - entry_fee
        else:
            curve[t] = equity

    if pos != 0:
        equity = close_trade(n - 1, c[-1], "END", equity)
        curve[-1] = equity
    return pd.DataFrame(trades), pd.Series(curve, index=idx)


# --------------------------------------------------------------- reports
def summarize(trades, curve, df, tf, capital):
    ppy = periods_per_year(tf)
    out = {}
    out["start -> end"] = f"{df.index[0].date()} -> {df.index[-1].date()}"
    out["buy & hold %"] = round((df["close"].iloc[-1] / df["close"].iloc[0] - 1) * 100, 1)
    out["strategy return %"] = round((curve.iloc[-1] / capital - 1) * 100, 1)
    dd = (curve / curve.cummax() - 1).min()
    out["max drawdown %"] = round(dd * 100, 1)
    rets = curve.pct_change().fillna(0)
    out["sharpe (per-bar, annualised)"] = round(float(rets.mean() / rets.std() * math.sqrt(ppy)), 2) if rets.std() > 0 else 0.0
    out["trades"] = len(trades)
    if len(trades):
        w = trades[trades["pnl"] > 0]
        lo = trades[trades["pnl"] <= 0]
        out["win rate %"] = round(len(w) / len(trades) * 100, 1)
        out["avg R per trade"] = round(float(trades["r"].mean()), 2)
        gl = abs(lo["pnl"].sum())
        out["profit factor"] = round(float(w["pnl"].sum() / gl), 2) if gl > 0 else float("inf")
        streak = best = 0
        for p in trades["pnl"]:
            streak = streak + 1 if p <= 0 else 0
            best = max(best, streak)
        out["longest losing streak"] = best
        out["exit reasons"] = trades["reason"].value_counts().to_dict()
        out["total fees + funding paid"] = round(float(trades["fees"].sum() + trades["funding"].sum()), 2)
    return out


def make_chart(df, trades, curve, path, bars, title):
    import plotly.graph_objects as go
    from plotly.subplots import make_subplots

    w = df.iloc[-bars:]
    t0, t1 = w.index[0], w.index[-1]
    tw = trades[(trades["exit_time"] >= t0) & (trades["entry_time"] <= t1)] if len(trades) else trades
    fig = make_subplots(rows=2, cols=1, shared_xaxes=True, row_heights=[0.76, 0.24], vertical_spacing=0.03)
    fig.add_trace(go.Candlestick(x=w.index, open=w["open"], high=w["high"], low=w["low"], close=w["close"],
                                 name="price", increasing_line_color="#22c55e", decreasing_line_color="#ef4444"), row=1, col=1)
    for r in tw.itertuples():
        fig.add_shape(type="rect", x0=r.entry_time, x1=r.exit_time, y0=r.entry, y1=r.tp,
                      fillcolor="rgba(34,197,94,0.22)", line_width=0, row=1, col=1)
        fig.add_shape(type="rect", x0=r.entry_time, x1=r.exit_time, y0=r.entry, y1=r.sl,
                      fillcolor="rgba(239,68,68,0.22)", line_width=0, row=1, col=1)
    if len(tw):
        txt = [f"#{r.id} {r.side}<br>entry {r.entry:.2f}<br>SL {r.sl:.2f}<br>TP {r.tp:.2f}<br>"
               f"exit {r.exit:.2f} ({r.reason})<br>P&L {r.pnl:+.2f} ({r.r:+.2f} R)" for r in tw.itertuples()]
        fig.add_trace(go.Scatter(x=tw["entry_time"], y=tw["entry"], mode="markers", name="entry", text=txt, hoverinfo="text",
                                 marker=dict(size=11, color="#38bdf8", line=dict(width=1, color="white"),
                                             symbol=["triangle-up" if s == "LONG" else "triangle-down" for s in tw["side"]])), row=1, col=1)
        fig.add_trace(go.Scatter(x=tw["exit_time"], y=tw["exit"], mode="markers", name="exit", text=txt, hoverinfo="text",
                                 marker=dict(size=10, symbol="x", line=dict(width=2),
                                             color=["#22c55e" if p > 0 else "#ef4444" for p in tw["pnl"]])), row=1, col=1)
    ew = curve.loc[t0:t1]
    fig.add_trace(go.Scatter(x=ew.index, y=ew.values, mode="lines", name="equity", line=dict(color="#f59e0b")), row=2, col=1)
    fig.update_layout(title=title, template="plotly_dark", height=900, xaxis_rangeslider_visible=False,
                      hovermode="closest", legend=dict(orientation="h", y=1.04))
    fig.update_xaxes(rangeslider_visible=False)
    fig.write_html(path, include_plotlyjs=True)
    return path


def parse_params(s):
    out = {}
    for kv in filter(None, (s or "").split(",")):
        k, v = kv.split("=")
        k, v = k.strip(), v.strip()
        if v.lower() in ("true", "false"):
            out[k] = v.lower() == "true"
        else:
            try:
                out[k] = int(v)
            except ValueError:
                out[k] = float(v)
    return out


def main():
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("path", nargs="?")
    r.add_argument("--tf", default="4h")
    r.add_argument("--strategy", choices=STRATEGIES, default="trend_atr")
    r.add_argument("--params", default="")
    r.add_argument("--market", choices=["spot", "futures"], default="spot")
    r.add_argument("--start")
    r.add_argument("--end")
    r.add_argument("--capital", type=float, default=1000.0)
    r.add_argument("--risk", type=float, default=0.01, help="fraction of equity risked per trade (0.01 = 1%%)")
    r.add_argument("--leverage", type=float, default=1.0)
    r.add_argument("--fee", type=float)
    r.add_argument("--slip", type=float)
    r.add_argument("--funding", type=float, help="funding rate per 8h, futures only (0.0001 = 0.01%%)")
    r.add_argument("--chart", action="store_true")
    r.add_argument("--chart-bars", type=int, default=1500)
    r.add_argument("--synthetic", action="store_true")
    a = p.parse_args()

    futures = a.market == "futures"
    fee = a.fee if a.fee is not None else (0.0005 if futures else 0.001)
    slip = a.slip if a.slip is not None else (0.0003 if futures else 0.0005)
    funding = a.funding if a.funding is not None else (0.0001 if futures else 0.0)
    leverage = a.leverage if futures else 1.0

    df = synthetic() if a.synthetic else load(a.path)
    params = parse_params(a.params)
    sig = STRATEGIES[a.strategy](df, **params)  # signals use full history (indicator warm-up) ...
    if a.start:
        m = df.index >= pd.Timestamp(a.start, tz="UTC")
        df, sig = df[m], sig[m]
    if a.end:
        m = df.index <= pd.Timestamp(a.end, tz="UTC")
        df, sig = df[m], sig[m]  # ... then we cut to the period we want to judge

    trades, curve = run_engine(df, sig, fee, slip, a.risk, leverage, a.capital, futures or False, funding, a.tf)
    print(f"\nmarket={a.market}  fee={fee*100:.3f}%  slippage={slip*100:.3f}%  risk/trade={a.risk*100:.1f}%  leverage={leverage}x  funding/8h={funding*100:.4f}%")
    for k, v in summarize(trades, curve, df, a.tf, a.capital).items():
        print(f"  {k:<30}{v}")
    if len(trades):
        os.makedirs("out", exist_ok=True)
        tp = "out/trades.csv"
        trades.to_csv(tp, index=False)
        print(f"\ntrade log saved -> {tp}")
        show = trades[["id", "side", "entry_time", "entry", "sl", "tp", "exit", "reason", "pnl", "r"]].tail(10).copy()
        show["entry_time"] = show["entry_time"].dt.strftime("%Y-%m-%d %H:%M")
        num = ["entry", "sl", "tp", "exit", "pnl", "r"]
        show[num] = show[num].round(2)
        print(show.to_string(index=False))
    if a.chart:
        os.makedirs("out", exist_ok=True)
        path = make_chart(df, trades, curve, "out/chart.html", a.chart_bars, f"{a.strategy}  {a.market}  trades={len(trades)}")
        print(f"\nchart saved -> {path}  (opening in your browser)")
        webbrowser.open("file://" + os.path.abspath(path))


if __name__ == "__main__":
    main()