#!/usr/bin/env python3
"""
jeafx.py - JeaFX price-action strategy, coded from jeafx_rule_sheet.md.

Rule numbers (R1, R5, ...) below match the rule sheet. Everything is decided candle by candle:
a decision at a candle's close only uses information up to that close (no look-ahead).

Your base data (e.g. 15m or 1h CSV) is the LOWER timeframe (LTF, used for confirmation).
The HIGHER timeframe (HTF, used for structure and zones) is built from it: htf_mult base candles per HTF candle
(1h/15m -> 4, 4h/1h -> 4).

Used through backtest2.py / replay.py:
  python backtest2.py run data/BTC_USDT_15m.csv --tf 15m --strategy jeafx --params "mode=confirm,htf_mult=4" --market futures
  python replay.py     data/BTC_USDT_15m.csv --tf 15m --strategy jeafx --params "mode=limit,htf_mult=4" --market futures --bars 3000
"""
import collections
import itertools

import numpy as np
import pandas as pd

# Filled by every run; replay.py reads it to draw zones, swings and breaks of structure on the chart.
LAST_OVERLAYS = {"zones": [], "swings": [], "bos": []}
LAST_STATS = {}  # funnel: how many setups survived each filter (printed by backtest2.py)


# ---------------------------------------------------------------- structure (R1, R2, R3)
class Structure:
    """Swings by ATR zigzag (R1, option A), breaks of structure on BODY closes (R2), trend state (R3)."""

    def __init__(self, k=1.5, atr_n=14, sweep_tol=0.1):
        self.k, self.alpha, self.sweep_tol = k, 1.0 / atr_n, sweep_tol
        self.o, self.h, self.l, self.c, self.atrs = [], [], [], [], []
        self.n = 0
        self.looking = None  # None (start), "high" (up-leg, waiting for a swing high) or "low"
        self.cand_hi = self.cand_lo = None
        self.sh, self.sl = [], []  # confirmed swing highs / lows
        self.trend = 0
        self.last_bos_idx = -10 ** 9

    @property
    def atr(self):
        return self.atrs[-1]

    def _confirm(self, kind, price, idx, now, ev):
        d = {"price": price, "idx": idx, "conf": now, "used": False, "swept": False}
        (self.sh if kind == "high" else self.sl).append(d)
        ev.append({"type": "swing", "kind": kind, "price": price, "idx": idx, "conf": now})

    def update(self, o, h, l, c):
        i = self.n
        pc = self.c[-1] if self.c else None
        tr = (h - l) if pc is None else max(h - l, abs(h - pc), abs(l - pc))
        atr = tr if not self.atrs else self.atrs[-1] * (1 - self.alpha) + tr * self.alpha
        for lst, arr in ((self.o, o), (self.h, h), (self.l, l), (self.c, c), (self.atrs, atr)):
            lst.append(arr)
        self.n += 1
        ev = []
        tol = self.sweep_tol * atr
        for s in self.sl:  # a wick beyond a low (by more than the tolerance) = swept liquidity
            if not s["swept"] and i > s["idx"] and l < s["price"] - tol:
                s["swept"] = True
        for s in self.sh:
            if not s["swept"] and i > s["idx"] and h > s["price"] + tol:
                s["swept"] = True

        # R2: break of structure = candle BODY closes beyond the last confirmed swing
        if self.sh and not self.sh[-1]["used"] and c > self.sh[-1]["price"]:
            s = self.sh[-1]
            s["used"] = True
            self.trend, self.last_bos_idx = 1, i
            ev.append({"type": "bos", "dir": 1, "idx": i, "level": s["price"], "level_idx": s["idx"],
                       "struct": self.sl[-1] if self.sl else None})
        if self.sl and not self.sl[-1]["used"] and c < self.sl[-1]["price"]:
            s = self.sl[-1]
            s["used"] = True
            self.trend, self.last_bos_idx = -1, i
            ev.append({"type": "bos", "dir": -1, "idx": i, "level": s["price"], "level_idx": s["idx"],
                       "struct": self.sh[-1] if self.sh else None})

        # R1: zigzag swings, confirmed once price reverses k x ATR from the extreme
        thr = self.k * atr
        if self.looking is None:
            if self.cand_hi is None:
                self.cand_hi, self.cand_lo = (h, i), (l, i)
            else:
                if h > self.cand_hi[0]:
                    self.cand_hi = (h, i)
                if l < self.cand_lo[0]:
                    self.cand_lo = (l, i)
            if self.cand_hi[0] - l >= thr and self.cand_hi[1] < i:
                self._confirm("high", self.cand_hi[0], self.cand_hi[1], i, ev)
                self.looking, self.cand_lo = "low", (l, i)
            elif h - self.cand_lo[0] >= thr and self.cand_lo[1] < i:
                self._confirm("low", self.cand_lo[0], self.cand_lo[1], i, ev)
                self.looking, self.cand_hi = "high", (h, i)
        elif self.looking == "high":
            if h > self.cand_hi[0]:
                self.cand_hi = (h, i)
            elif self.cand_hi[0] - l >= thr:
                self._confirm("high", self.cand_hi[0], self.cand_hi[1], i, ev)
                self.looking, self.cand_lo = "low", (l, i)
        else:
            if l < self.cand_lo[0]:
                self.cand_lo = (l, i)
            elif h - self.cand_lo[0] >= thr:
                self._confirm("low", self.cand_lo[0], self.cand_lo[1], i, ev)
                self.looking, self.cand_hi = "high", (h, i)
        return ev


# ---------------------------------------------------------------- helpers
def find_zone(S, start, end, direction, pick, imp_body):
    """
    R6: the zone is the LAST candle before the impulse. Impulsive candle = body >= imp_body x ATR in the move's direction.
    pick='largest': the biggest impulsive candle in (start, end].  pick='first': the first one after start.
    Returns (zone_candle_index, low, high) or None.
    """
    best = None
    for j in range(start + 1, end + 1):
        body = (S.c[j] - S.o[j]) * direction
        if body >= imp_body * S.atrs[j]:
            if pick == "first":
                best = j
                break
            if best is None or body > (S.c[best] - S.o[best]) * direction:
                best = j
    if best is None:
        return None
    z = best - 1
    while z - 1 >= start and (S.c[z] - S.o[z]) * direction >= imp_body * S.atrs[z]:
        z -= 1  # still inside the impulse: walk back to the last candle before it
    if z < start:
        return None
    return z, S.l[z], S.h[z]


def strat_jeafx(df, mode="confirm", htf_mult=4, bias_mult=0, k=1.5, atr_n=14, rr=2.0, buf=0.1,
                zone_age=120, cons_n=30, cons_m=20, cons_c=4.0, mom=1, mom_speed=0.5, mom_dur=1.5,
                veto_body=3.0, bos_body=1.0, bos_speed=0.5, imp_body=1.0, eq_tol=0.1, eq_dist=5.0,
                confirm_bars=40, flip=1, bounce=0.5, flip_age=40, allow_short=True):
    """
    mode='confirm': R13 confirmation model (price touches a fresh zone, then the LTF breaks structure our way, enter next open).
    mode='limit'  : limit order resting at the zone edge.
    bias_mult     : R19 option. >0 requires the structure of a bigger timeframe (bias_mult HTF candles per candle) to agree.
    """
    o, h, l, c = (df[x].values.astype(float) for x in ("open", "high", "low", "close"))
    n = len(df)
    ts = ((df.index - pd.Timestamp("1970-01-01", tz="UTC")) // pd.Timedelta("1ms")).astype("int64")
    base_ms = int(np.median(np.diff(ts))) if n > 1 else 1
    bucket = ts // (base_ms * int(htf_mult))

    side = np.zeros(n, dtype=int)
    sl_out = np.full(n, np.nan)
    tp_out = np.full(n, np.nan)
    ent_out = np.full(n, np.nan)

    htf, ltf = Structure(k, atr_n, eq_tol), Structure(k, atr_n, eq_tol)
    bias = Structure(k, atr_n, eq_tol) if bias_mult > 0 else None
    bias_acc, bias_cnt = None, 0
    acc = None
    htf_start, htf_end = [], []  # base index where each HTF candle starts / completes
    zones, active, fails = [], [], []
    ov_swings, ov_bos = [], []
    cnt = collections.Counter()

    def body_dir(S, j, d):
        return (S.c[j] - S.o[j]) * d

    def equal_block(s_side, entry):
        a = htf.atr
        if s_side == 1:  # never buy above unswept equal lows
            pts = [x["price"] for x in htf.sl[-12:] if not x["swept"] and x["price"] < entry and entry - x["price"] <= eq_dist * a]
        else:  # never sell below unswept equal highs
            pts = [x["price"] for x in htf.sh[-12:] if not x["swept"] and x["price"] > entry and x["price"] - entry <= eq_dist * a]
        return any(abs(p - q) <= eq_tol * a for p, q in itertools.combinations(pts, 2))

    def consolidating():
        hn = htf.n
        if hn - 1 - htf.last_bos_idx > cons_n:
            return True
        if hn >= cons_m:
            rng = max(htf.h[-cons_m:]) - min(htf.l[-cons_m:])
            if rng < cons_c * htf.atr:
                return True
        return False

    def momentum_ok(z, entry, now_h):
        if not mom or z["flip"]:
            return True
        imp_dist = abs(z["peak"] - z["L_price"])
        imp_dur = max(1, z["peak_i"] - z["L_idx"])
        pb_dist = abs(z["peak"] - entry)
        pb_dur = max(1, now_h - z["peak_i"])
        return (pb_dist / pb_dur) <= mom_speed * (imp_dist / imp_dur) and pb_dur >= mom_dur * imp_dur

    def pick_target(z, entry, risk):
        if z["side"] == 1:
            cands = [x["price"] for x in htf.sh[-30:] if x["price"] > entry]
            if not z["flip"] and z["peak"] > entry:
                cands.append(z["peak"])
            for t in sorted(set(cands)):
                if (t - entry) / risk >= rr:
                    return t
        else:
            cands = [x["price"] for x in htf.sl[-30:] if x["price"] < entry]
            if not z["flip"] and z["peak"] < entry:
                cands.append(z["peak"])
            for t in sorted(set(cands), reverse=True):
                if (entry - t) / risk >= rr:
                    return t
        return None

    def setup(z, entry, now_h, mom_pre=None):
        """R9, R3, R5, R10, R14, R15 checks. Returns (sl, tp) or None."""
        s_ = z["side"]
        if not z["flip"]:
            if htf.trend != s_:
                z["why"] = "R9 trend not aligned"
                return None
            if consolidating():
                z["why"] = "R3 consolidation"
                return None
            if z["veto"]:
                z["why"] = "R5 opposing big candle"
                return None
            if bias is not None and bias.trend != s_:
                z["why"] = "R19 bias disagrees"
                return None
        ok_m = mom_pre if mom_pre is not None else momentum_ok(z, entry, now_h)
        if not ok_m:
            z["why"] = "R5 pullback not weak/slow enough"
            return None
        if equal_block(s_, entry):
            z["why"] = "R10 equal highs/lows"
            return None
        stop = z["lo"] - buf * z["atr"] if s_ == 1 else z["hi"] + buf * z["atr"]
        risk = (entry - stop) * s_
        if risk <= 0:
            z["why"] = "stop on wrong side"
            return None
        tgt = pick_target(z, entry, risk)
        if tgt is None:
            z["why"] = "R15 no target with RR>=min"
            return None
        z["why"] = "passed all filters"
        return stop, tgt

    def new_zone(s_, zinfo, hj, i, L_price, L_idx, peak, peak_i, flip_):
        zi, zlo, zhi = zinfo
        z = {"id": len(zones) + 1, "side": s_, "lo": zlo, "hi": zhi, "zidx": zi, "hidx": hj, "bidx": i,
             "L_price": L_price, "L_idx": L_idx, "peak": peak, "peak_i": peak_i, "state": "fresh",
             "veto": False, "flip": flip_, "atr": htf.atr, "touch_i": None, "touch_h": None, "mom_ok": True,
             "alive": True, "end_i": None, "why": "never evaluated (price never came back / zone failed first)"}
        zones.append(z)
        active.append(z)

    def kill(z, i, state="dead"):
        z["state"] = state
        z["alive"] = False
        if z["end_i"] is None:
            z["end_i"] = i

    def process_htf(events, i):
        hj = htf.n - 1
        # existing zones: peak tracking, veto candle, failure (R17 trigger), expiry
        for z in list(active):
            s_ = z["side"]
            if hj > z["hidx"]:
                if z["state"] == "fresh":
                    if (s_ == 1 and htf.h[hj] > z["peak"]) or (s_ == -1 and htf.l[hj] < z["peak"]):
                        z["peak"] = htf.h[hj] if s_ == 1 else htf.l[hj]
                        z["peak_i"] = hj
                    elif -body_dir(htf, hj, s_) >= veto_body * htf.atrs[hj]:
                        z["veto"] = True
                failed = (s_ == 1 and htf.c[hj] < z["lo"]) or (s_ == -1 and htf.c[hj] > z["hi"])
                if failed:
                    if flip and not z["flip"]:
                        fails.append({"s": s_, "B": hj, "ext": htf.l[hj] if s_ == 1 else htf.h[hj], "lvl1": z["peak"],
                                      "ext2": None, "ext2_i": None})
                    kill(z, i, "failed")
                    active.remove(z)
                    continue
                if hj - z["hidx"] > zone_age:
                    kill(z, i, "expired")
                    active.remove(z)
        # R17: demand broken -> bounce fails to take the earlier high -> close below the breaking candle -> supply at the lower high
        for f in list(fails):
            if hj <= f["B"]:
                continue
            s_ = f["s"]
            c_now = htf.c[hj]
            cancel = (s_ == 1 and c_now > f["lvl1"]) or (s_ == -1 and c_now < f["lvl1"]) or hj - f["B"] > flip_age
            confirm = False
            if not cancel and f["ext2"] is not None and hj - f["B"] >= 2:
                if s_ == 1:
                    confirm = c_now < f["ext"] and f["ext2"] < f["lvl1"] and f["ext2"] - f["ext"] >= bounce * htf.atr
                else:
                    confirm = c_now > f["ext"] and f["ext2"] > f["lvl1"] and f["ext"] - f["ext2"] >= bounce * htf.atr
            if cancel:
                fails.remove(f)
            elif confirm:
                zi = find_zone(htf, f["ext2_i"], hj, -s_, "first", imp_body)
                if zi is None:
                    zi = (f["ext2_i"], htf.l[f["ext2_i"]], htf.h[f["ext2_i"]])  # the lower-high candle itself
                new_zone(-s_, zi, hj, i, 0.0, 0, 0.0, hj, True)
                fails.remove(f)
            else:
                v = htf.h[hj] if s_ == 1 else htf.l[hj]
                if f["ext2"] is None or (s_ == 1 and v > f["ext2"]) or (s_ == -1 and v < f["ext2"]):
                    f["ext2"], f["ext2_i"] = v, hj
        # new swings / breaks of structure -> new zones (R6) with BOS quality checks (R5)
        for e in events:
            if e["type"] == "swing":
                ov_swings.append((e["kind"], e["price"], htf_start[e["idx"]], i))
            elif e["type"] == "bos":
                ov_bos.append((e["dir"], e["level"], htf_start[e["level_idx"]], i))
                st = e["struct"]
                d = e["dir"]
                cnt["breaks of structure"] += 1
                if st is None:
                    continue
                Lp, Li = st["price"], st["idx"]
                if Li >= hj:
                    continue
                if abs(htf.c[hj] - htf.o[hj]) < bos_body * htf.atr:
                    cnt["BOS rejected: candle body too small (R5)"] += 1
                    continue
                leg_ext = max(htf.h[Li:hj + 1]) if d == 1 else min(htf.l[Li:hj + 1])
                if abs(leg_ext - Lp) / htf.atr / max(1, hj - Li) < bos_speed:
                    cnt["BOS rejected: slow grind (R5)"] += 1
                    continue
                zinfo = find_zone(htf, Li, hj, d, "largest", imp_body)
                if zinfo is None:
                    cnt["BOS rejected: no impulsive candle for a zone (R6)"] += 1
                    continue
                pk_i = int(np.argmax(htf.h[Li:hj + 1])) + Li if d == 1 else int(np.argmin(htf.l[Li:hj + 1])) + Li
                new_zone(d, zinfo, hj, i, Lp, Li, leg_ext, pk_i, False)

    for i in range(n):
        if acc is None:
            acc = [o[i], h[i], l[i], c[i], i]
        else:
            acc[1], acc[2], acc[3] = max(acc[1], h[i]), min(acc[2], l[i]), c[i]
        done = i == n - 1 or bucket[i + 1] != bucket[i]
        if done:
            htf_start.append(acc[4])
            htf_end.append(i)
            ev = htf.update(acc[0], acc[1], acc[2], acc[3])
            process_htf(ev, i)
            if bias is not None:
                if bias_acc is None:
                    bias_acc = [acc[0], acc[1], acc[2], acc[3]]
                else:
                    bias_acc[1], bias_acc[2], bias_acc[3] = max(bias_acc[1], acc[1]), min(bias_acc[2], acc[2]), acc[3]
                bias_cnt += 1
                if bias_cnt >= bias_mult:
                    bias.update(*bias_acc)
                    bias_acc, bias_cnt = None, 0
            acc = None
        ev_l = ltf.update(o[i], h[i], l[i], c[i])
        if htf.n < 3 or htf.n - 1 < 0:
            continue
        now_h = htf.n - 1

        # touches of zones (first tap only, R7)
        for z in list(active):
            if i <= z["bidx"] or z["state"] not in ("fresh", "touched"):
                continue
            touched = (z["side"] == 1 and l[i] <= z["hi"]) or (z["side"] == -1 and h[i] >= z["lo"])
            if z["state"] == "fresh" and touched:
                z["touch_i"] = i
                if mode == "limit":
                    z["state"], z["end_i"] = "tapped", i
                else:
                    z["state"], z["touch_h"] = "touched", now_h
                    edge = z["hi"] if z["side"] == 1 else z["lo"]
                    z["mom_ok"] = momentum_ok(z, edge, now_h)
            if z["state"] == "touched" and i - z["touch_i"] > confirm_bars:
                z["state"], z["end_i"] = "tapped", i

        # entries
        if mode == "limit":
            best = None
            for z in active:
                if z["state"] != "fresh" or i <= z["bidx"]:
                    continue
                if z["side"] == -1 and not allow_short:
                    continue
                edge = z["hi"] if z["side"] == 1 else z["lo"]
                if (z["side"] == 1 and c[i] <= edge) or (z["side"] == -1 and c[i] >= edge):
                    continue
                res = setup(z, edge, now_h)
                if res is None:
                    continue
                dist = abs(c[i] - edge)
                if best is None or dist < best[0]:
                    best = (dist, z, edge, res)
            if best is not None:
                _, z, edge, (stop, tgt) = best
                side[i], sl_out[i], tp_out[i], ent_out[i] = z["side"], stop, tgt, edge
        else:
            for e in ev_l:
                if e["type"] != "bos":
                    continue
                for z in active:
                    if z["state"] != "touched" or z["side"] != e["dir"]:
                        continue
                    if z["side"] == -1 and not allow_short:
                        continue
                    res = setup(z, c[i], now_h, mom_pre=z["mom_ok"])
                    if res is None:
                        continue
                    stop, tgt = res
                    side[i], sl_out[i], tp_out[i] = z["side"], stop, tgt
                    z["state"], z["end_i"] = "used", i
                    break
                if side[i] != 0:
                    break

    # overlays for the replay chart
    zl = []
    for z in zones:
        zl.append({"side": z["side"], "lo": z["lo"], "hi": z["hi"], "flip": z["flip"],
                   "start": int(htf_start[z["zidx"]]) if z["zidx"] < len(htf_start) else int(z["bidx"]),
                   "born": int(z["bidx"]), "end": int(z["end_i"] if z["end_i"] is not None else n - 1),
                   "state": z["state"]})
    LAST_OVERLAYS["zones"], LAST_OVERLAYS["swings"], LAST_OVERLAYS["bos"] = zl, ov_swings, ov_bos
    cnt["zones created"] = len(zones)
    cnt["  of which flip zones (R17)"] = sum(1 for z in zones if z["flip"])
    cnt["zones that price came back to (first tap)"] = sum(1 for z in zones if z["touch_i"] is not None)
    for z in zones:
        cnt["zone outcome: " + z["why"]] += 1
    LAST_STATS.clear()
    LAST_STATS.update(cnt)

    return pd.DataFrame({"side": side, "sl": sl_out, "tp": tp_out, "entry": ent_out,
                         "close_long": False, "close_short": False}, index=df.index)